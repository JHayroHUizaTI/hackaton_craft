# ============================================================
# Copia este archivo a .env en el VPS y rellena los valores.
# NO subas .env al repositorio.
# ============================================================

# ── Base de datos ───────────────────────────────────────────
DB_USER=crm
DB_PASSWORD=CAMBIA_ESTO_por_contraseña_segura
DB_NAME=crm

# ── Dominios públicos ────────────────────────────────────────
# URL del frontend (donde llegan los usuarios)
AUTH_URL=https://tu-dominio.com
# URL pública del API (usada en el navegador del cliente)
NEXT_PUBLIC_API_URL=https://tu-dominio.com
# Orígenes permitidos en el CORS del API (separados por coma si hay varios)
WEB_ORIGIN=https://tu-dominio.com

# ── NextAuth ─────────────────────────────────────────────────
# Genera con: openssl rand -base64 32
AUTH_SECRET=CAMBIA_ESTO

# ── JWT ──────────────────────────────────────────────────────
# Genera con: openssl rand -base64 32
JWT_ACCESS_SECRET=CAMBIA_ESTO
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# ── IA ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
VOYAGE_API_KEY=

# ── WhatsApp Cloud API ───────────────────────────────────────
WHATSAPP_APP_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Token aleatorio que pusiste en Meta → Configuración de Webhooks
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0

# ── WhatsApp Embedded Signup (frontend, horneado en build) ───
NEXT_PUBLIC_WHATSAPP_APP_ID=
NEXT_PUBLIC_WHATSAPP_CONFIG_ID=

# ── Empresa (política de privacidad) ────────────────────────
NEXT_PUBLIC_COMPANY_NAME=CRM Prime
NEXT_PUBLIC_CONTACT_EMAIL=contacto@tu-dominio.com
